#!/bin/sh

set -eu

MODE="${1:-}"
MOUNTPOINT="{{ k3s_local_storage_mountpoint }}"
STATE_DIR="{{ k3s_local_storage_state_dir }}"
STATE_FILE="{{ k3s_local_storage_node_password_state_path }}"
CA_HASH_STATE_FILE="{{ k3s_local_storage_server_ca_hash_state_path }}"
CLUSTER_TOKEN_FILE="{{ k3s_local_storage_cluster_token_path }}"
RESET_IDENTITY_WHEN_LOCAL_PASSWORD_MISSING="{{ k3s_local_storage_reset_identity_when_local_password_missing | bool | ternary('true', 'false') }}"
AGENT_DIR="${MOUNTPOINT}/agent"
LOCAL_DIR="/etc/rancher/node"
LOCAL_FILE="${LOCAL_DIR}/password"
STATUS_DIR="/run/k3s-node-password-sync"

present() {
  if [ -s "$1" ]; then
    printf true
  else
    printf false
  fi
}

record_status() {
  mode="$1"
  outcome="$2"
  local_before="$3"
  state_before="$4"
  ca_state_before="$5"
  identity_before="$6"
  boot_id="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
  case "${boot_id}" in
    *[!0-9a-f-]*|'') boot_id=unknown ;;
  esac
  install -d -m 0700 "${STATUS_DIR}"
  temporary="$(mktemp "${STATUS_DIR}/${mode}.XXXXXX")"
  {
    printf 'schema=1\n'
    printf 'boot_id=%s\n' "${boot_id}"
    printf 'mode=%s\n' "${mode}"
    printf 'outcome=%s\n' "${outcome}"
    printf 'local_password_present_before=%s\n' "${local_before}"
    printf 'ssd_password_present_before=%s\n' "${state_before}"
    printf 'ssd_ca_hash_present_before=%s\n' "${ca_state_before}"
    printf 'agent_identity_present_before=%s\n' "${identity_before}"
  } > "${temporary}"
  chmod 0600 "${temporary}"
  mv -f "${temporary}" "${STATUS_DIR}/${mode}.state"
  if [ "${mode}" = restore ]; then
    ln "${STATUS_DIR}/restore.state" "${STATUS_DIR}/restore-first.state" 2>/dev/null || true
  fi
}

wait_for_mount() {
  for _ in $(seq 1 30); do
    mounted_target="$(findmnt -n -T "${MOUNTPOINT}" -o TARGET 2>/dev/null || true)"
    if [ "${mounted_target}" = "${MOUNTPOINT}" ]; then
      return 0
    fi
    sleep 1
  done

  echo "mountpoint is not ready: ${MOUNTPOINT}" >&2
  return 1
}

ensure_dirs() {
  install -d -m 0700 "${STATE_DIR}"
  install -d -m 0755 "${LOCAL_DIR}"
}

current_token_ca_hash() {
  [ -s "${CLUSTER_TOKEN_FILE}" ] || return 1
  token="$(tr -d '\r\n' < "${CLUSTER_TOKEN_FILE}")"
  case "${token}" in
    K10*::*)
      rest="${token#K10}"
      printf '%s\n' "${rest%%::*}"
      ;;
    *)
      return 1
      ;;
  esac
}

agent_identity_exists() {
  [ -e "${AGENT_DIR}/server-ca.crt" ] ||
    [ -e "${AGENT_DIR}/client-kubelet.crt" ] ||
    [ -e "${AGENT_DIR}/kubelet.kubeconfig" ]
}

reset_agent_identity() {
  rm -f "${LOCAL_FILE}" "${STATE_FILE}" "${CA_HASH_STATE_FILE}"
  rm -f \
    "${AGENT_DIR}"/client-*.crt \
    "${AGENT_DIR}"/client-*.key \
    "${AGENT_DIR}"/serving-kubelet.crt \
    "${AGENT_DIR}"/serving-kubelet.key \
    "${AGENT_DIR}"/server-ca.crt \
    "${AGENT_DIR}"/*.kubeconfig \
    "${AGENT_DIR}/etc/k3s-agent-load-balancer.json"
}

restore_password() {
  if ! wait_for_mount; then
    record_status restore mount_unavailable "$(present "${LOCAL_FILE}")" unknown unknown unknown
    return 1
  fi
  ensure_dirs

  local_before="$(present "${LOCAL_FILE}")"
  state_before="$(present "${STATE_FILE}")"
  ca_state_before="$(present "${CA_HASH_STATE_FILE}")"
  identity_before=false
  if agent_identity_exists; then
    identity_before=true
  fi

  if [ "${RESET_IDENTITY_WHEN_LOCAL_PASSWORD_MISSING}" = "true" ] && [ ! -s "${LOCAL_FILE}" ]; then
    if [ -s "${STATE_FILE}" ] || [ -s "${CA_HASH_STATE_FILE}" ] || agent_identity_exists; then
      echo "local node password is missing; resetting persisted agent identity" >&2
      reset_agent_identity
      record_status restore reset_missing_local "${local_before}" "${state_before}" "${ca_state_before}" "${identity_before}"
    else
      record_status restore no_prior_identity "${local_before}" "${state_before}" "${ca_state_before}" "${identity_before}"
    fi
    return 0
  fi

  current_hash="$(current_token_ca_hash 2>/dev/null || true)"
  stored_hash=""
  if [ -s "${CA_HASH_STATE_FILE}" ]; then
    stored_hash="$(tr -d '\r\n' < "${CA_HASH_STATE_FILE}")"
  fi

  if [ -n "${current_hash}" ] && [ -n "${stored_hash}" ] && [ "${current_hash}" != "${stored_hash}" ]; then
    echo "k3s server CA hash changed; resetting persisted agent identity" >&2
    reset_agent_identity
    record_status restore reset_ca_changed "${local_before}" "${state_before}" "${ca_state_before}" "${identity_before}"
    return 0
  fi

  if [ -n "${current_hash}" ] && [ -z "${stored_hash}" ] && agent_identity_exists; then
    echo "k3s server CA hash state is missing; resetting existing agent identity once" >&2
    reset_agent_identity
    record_status restore reset_ca_state_missing "${local_before}" "${state_before}" "${ca_state_before}" "${identity_before}"
    return 0
  fi

  if [ -s "${STATE_FILE}" ]; then
    install -m 0600 "${STATE_FILE}" "${LOCAL_FILE}"
    record_status restore restored_ssd "${local_before}" "${state_before}" "${ca_state_before}" "${identity_before}"
  else
    record_status restore ssd_password_missing "${local_before}" "${state_before}" "${ca_state_before}" "${identity_before}"
  fi
}

persist_password() {
  local_before="$(present "${LOCAL_FILE}")"
  if ! wait_for_mount; then
    record_status persist mount_unavailable "${local_before}" unknown unknown unknown
    return 0
  fi
  ensure_dirs
  state_before="$(present "${STATE_FILE}")"
  ca_state_before="$(present "${CA_HASH_STATE_FILE}")"
  identity_before=false
  if agent_identity_exists; then
    identity_before=true
  fi

  for _ in $(seq 1 60); do
    if [ -s "${LOCAL_FILE}" ]; then
      install -m 0600 "${LOCAL_FILE}" "${STATE_FILE}"
      current_hash="$(current_token_ca_hash 2>/dev/null || true)"
      if [ -n "${current_hash}" ]; then
        printf '%s\n' "${current_hash}" > "${CA_HASH_STATE_FILE}"
        chmod 0600 "${CA_HASH_STATE_FILE}"
      fi
      record_status persist persisted "${local_before}" "${state_before}" "${ca_state_before}" "${identity_before}"
      return 0
    fi
    sleep 1
  done

  echo "node password was not created under ${LOCAL_FILE}" >&2
  record_status persist password_missing_after_timeout "${local_before}" "${state_before}" "${ca_state_before}" "${identity_before}"
  return 0
}

case "${MODE}" in
  restore)
    restore_password
    ;;
  persist)
    persist_password
    ;;
  *)
    echo "usage: $0 restore|persist" >&2
    exit 2
    ;;
esac
