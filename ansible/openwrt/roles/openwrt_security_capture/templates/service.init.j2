#!/bin/sh /etc/rc.common
# On-demand only. No respawn: a failed capture must not restart itself.
START=97
USE_PROCD=1

start_service() {
    procd_open_instance capture
    procd_set_param command /usr/bin/python3 /usr/libexec/homecluster-security-capture.py serve
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_set_param term_timeout 15
    procd_close_instance
}
