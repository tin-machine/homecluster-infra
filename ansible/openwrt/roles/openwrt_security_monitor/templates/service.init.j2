#!/bin/sh /etc/rc.common
# Managed by Ansible: security heartbeat only.
START=96
USE_PROCD=1

start_service() {
    procd_open_instance monitor
    procd_set_param command /usr/bin/python3 /usr/libexec/homecluster-security-monitor.py --config /etc/homecluster-security-monitor.json
    procd_set_param respawn 3600 10 5
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}
