[Unit]
Description=RAM-backed Wi-Fi daemon for the NFS root
DefaultDependencies=no
IgnoreOnIsolate=yes
RefuseManualStop=yes
SurviveFinalKillSignal=yes

[Service]
Type=simple
RootDirectory=/run/sd-netboot-runtime
MountAPIVFS=yes
BindPaths=/run/sd-netboot-state:/run/sd-netboot-state
ExecStart=/bin/sh /run/sd-netboot-state/wpa-start
ExecStartPost=/bin/sh -c 'echo "$$MAINPID" > /run/sd-netboot-state/wpa.pid'
Restart=always
RestartSec=2
StandardOutput=null
StandardError=null
