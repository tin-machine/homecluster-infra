#!/usr/bin/env python3
from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any, Mapping, Sequence

HERE = Path(__file__).resolve().parent
LEGACY = HERE / "pi-rpi5-common-kernel-rollout-legacy"


def load_legacy():
    loader = importlib.machinery.SourceFileLoader("pi_rpi5_common_kernel_rollout_legacy", str(LEGACY))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        raise RuntimeError("legacy_rollout_loader_unavailable")
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    spec.loader.exec_module(module)
    return module


legacy = load_legacy()

_CURRENT_ACTION = ""
_LAST_FRESH_BOOT_STATUS = ""
_LAST_KERNEL_ACCEPTANCE: bool | None = None
_PRE_ROLLOUT_CLUSTER_STATUS = "not_checked"
_PRE_ROLLOUT_CLUSTER_ISSUES = "none"

_original_target_policy = legacy.target_policy
_original_run_fresh_boot = legacy.run_fresh_boot
_original_phase_record_value = legacy.phase_record_value
_original_fixture_result = legacy.fixture_result


def target_policy(
    root: Path,
    phase: str,
    agents: Sequence[str],
    egpu_target: str,
) -> tuple[list[str], dict[str, Any], str]:
    global _CURRENT_ACTION, _LAST_FRESH_BOOT_STATUS, _LAST_KERNEL_ACCEPTANCE
    _CURRENT_ACTION = phase
    _LAST_FRESH_BOOT_STATUS = ""
    _LAST_KERNEL_ACCEPTANCE = None

    if phase != "rollback_last_phase":
        return _original_target_policy(root, phase, agents, egpu_target)

    failed: dict[str, Any] = {}
    for candidate in reversed(legacy.RUNTIME_PHASES):
        value = legacy.phase_record(root, candidate)
        if value.get("acceptance_status") == "fail" and value.get("rollback_recommended") is True:
            failed = value
            break

    previous = failed.get("previous_selector_by_node") if failed else None
    targets = failed.get("targets") if failed else None
    failed_phase = str(failed.get("phase", "")) if failed else ""
    if failed_phase not in legacy.RUNTIME_PHASES or not isinstance(previous, dict) or not previous:
        raise legacy.RolloutError("known_rollback_unavailable")
    if not isinstance(targets, list) or not targets or any(target not in agents for target in targets):
        raise legacy.RolloutError("rollback_target_contract_invalid", "unknown")
    for target in targets:
        selector = previous.get(target)
        if not isinstance(selector, dict):
            raise legacy.RolloutError("rollback_selector_contract_invalid", "unknown")
        if not legacy.SELECTOR.fullmatch(str(selector.get("tftp_release", ""))) or not legacy.SELECTOR.fullmatch(
            str(selector.get("rootfs_release", ""))
        ):
            raise legacy.RolloutError("rollback_selector_contract_invalid", "unknown")
    return [str(item) for item in targets], previous, failed_phase


def observe_cluster_health(runbook: Path) -> None:
    global _PRE_ROLLOUT_CLUSTER_STATUS, _PRE_ROLLOUT_CLUSTER_ISSUES
    helper = runbook / "scripts/pi-k3s-status"
    if not helper.is_file():
        _PRE_ROLLOUT_CLUSTER_STATUS = "unavailable"
        _PRE_ROLLOUT_CLUSTER_ISSUES = "status_helper_missing"
        return

    completed = legacy.run(["bash", helper, "--json"], cwd=runbook, timeout=900)
    try:
        value = json.loads(completed.stdout)
    except (ValueError, json.JSONDecodeError):
        _PRE_ROLLOUT_CLUSTER_STATUS = "unknown"
        _PRE_ROLLOUT_CLUSTER_ISSUES = "invalid_status_json"
        return
    if not isinstance(value, dict):
        _PRE_ROLLOUT_CLUSTER_STATUS = "unknown"
        _PRE_ROLLOUT_CLUSTER_ISSUES = "invalid_status_contract"
        return

    _PRE_ROLLOUT_CLUSTER_STATUS = str(value.get("status", "unknown"))
    issues = value.get("issues", [])
    if isinstance(issues, list):
        _PRE_ROLLOUT_CLUSTER_ISSUES = ",".join(str(item) for item in issues[:10]) or "none"
    else:
        _PRE_ROLLOUT_CLUSTER_ISSUES = "invalid"


def run_fresh_boot(runbook: Path) -> tuple[str, str]:
    global _LAST_FRESH_BOOT_STATUS
    run_id, status = _original_run_fresh_boot(runbook)
    _LAST_FRESH_BOOT_STATUS = status
    return run_id, status


def run_phase_acceptance(
    root: Path,
    runbook: Path,
    inventory: Path,
    phase: str,
    targets: Sequence[str],
    all_agents: Sequence[str],
    exact_release: str,
) -> tuple[bool, list[str]]:
    global _LAST_KERNEL_ACCEPTANCE
    diagnostics: list[str] = []
    playbook = root / "ansible/openwrt/playbooks/rpi5-common-kernel-phase-acceptance.yml"
    expect_exact = phase != "rollback_last_phase"
    acceptance_targets = list(all_agents) if phase == "fleet_rollout" else list(targets)
    completed = legacy.run(
        [
            "ansible-playbook",
            "-i",
            inventory,
            playbook,
            "--limit",
            ",".join(acceptance_targets),
            "--extra-vars",
            json.dumps(
                {
                    "homecluster_common_kernel_acceptance_phase": phase,
                    "homecluster_common_kernel_expect_exact_release": expect_exact,
                    "homecluster_common_kernel_exact_release": exact_release,
                },
                separators=(",", ":"),
            ),
        ],
        cwd=root / "ansible/openwrt",
        timeout=900,
    )
    if completed.returncode != 0:
        _LAST_KERNEL_ACCEPTANCE = False
        return False, [
            "phase_runtime_acceptance=fail",
            *legacy.ansible_failure_diagnostics(
                completed.stdout,
                completed.stderr,
                stage="phase_acceptance_after_power_cycle",
                mutation_committed=True,
                power_cycle_started=True,
                next_check_id="common_kernel_phase_acceptance",
            ),
        ]
    diagnostics.append("phase_runtime_acceptance=pass")

    # Cluster-wide application health is evidence, not a kernel acceptance gate.
    status_helper = runbook / "scripts/pi-k3s-status"
    if status_helper.is_file():
        observed = legacy.run(["bash", status_helper, "--json"], cwd=runbook, timeout=900)
        try:
            value = json.loads(observed.stdout)
        except (ValueError, json.JSONDecodeError):
            diagnostics.append("k3s_final_observation=unknown")
        else:
            if isinstance(value, dict):
                diagnostics.append(f"k3s_final_observation={value.get('status', 'unknown')}")
                issues = value.get("issues", [])
                if isinstance(issues, list) and issues:
                    diagnostics.append("k3s_final_warning_issues=" + ",".join(str(item) for item in issues[:10]))
            else:
                diagnostics.append("k3s_final_observation=unknown")
    else:
        diagnostics.append("k3s_final_observation=unavailable")

    if phase == "egpu_canary":
        llm_helper = runbook / "scripts/pi-rpi5-egpu-llm-status"
        if not llm_helper.is_file():
            _LAST_KERNEL_ACCEPTANCE = False
            return False, [*diagnostics, "llm_acceptance_helper=missing"]
        llm = legacy.run(
            ["bash", llm_helper],
            cwd=runbook,
            timeout=900,
            env={**os.environ, "HOMECLUSTER_RPI5_03_EXPECTED_KERNEL_RELEASE": exact_release},
        )
        values = legacy.parse_kv(llm.stdout)
        if (
            llm.returncode != 0
            or values.get("llm_status") != "healthy"
            or values.get("llm_failed_check_ids") != "none"
            or values.get("llm_unknown_check_ids") != "none"
        ):
            _LAST_KERNEL_ACCEPTANCE = False
            return False, [*diagnostics, "llm_acceptance=fail"]
        diagnostics.append("llm_acceptance=pass")

    _LAST_KERNEL_ACCEPTANCE = True
    return True, diagnostics


def selectors_changed(targets: Sequence[str], selector_result: Mapping[str, Any]) -> bool:
    previous = selector_result.get("previous_selector_by_node")
    applied = selector_result.get("applied_selector_by_node")
    if not isinstance(previous, dict) or not isinstance(applied, dict):
        return False
    return any(previous.get(target) != applied.get(target) for target in targets)


def phase_record_value(**kwargs: Any) -> dict[str, Any]:
    record = _original_phase_record_value(**kwargs)
    targets = kwargs.get("targets", [])
    selector_result = kwargs.get("selector_result", {})
    fresh_boot_run_id = str(kwargs.get("fresh_boot_run_id", ""))
    requested_acceptance = str(kwargs.get("acceptance_status", ""))

    record["pre_rollout_cluster_status"] = _PRE_ROLLOUT_CLUSTER_STATUS
    record["pre_rollout_cluster_issues"] = _PRE_ROLLOUT_CLUSTER_ISSUES
    record["selector_changed"] = selectors_changed(targets, selector_result) if isinstance(targets, Sequence) else False

    if _CURRENT_ACTION == "rollback_last_phase":
        record["reboot_acceptance_status"] = "pass" if _LAST_FRESH_BOOT_STATUS == "pass" else (_LAST_FRESH_BOOT_STATUS or "not_run")
        record["kernel_acceptance_status"] = "not_applicable"
        record["rollback_recommended"] = False
        return record

    if not fresh_boot_run_id:
        record["acceptance_status"] = "selector_failed" if requested_acceptance == "fail" else requested_acceptance
        record["reboot_acceptance_status"] = "not_run"
        record["kernel_acceptance_status"] = "not_run"
        record["rollback_recommended"] = False
        return record

    if _LAST_FRESH_BOOT_STATUS and _LAST_FRESH_BOOT_STATUS != "pass":
        record["acceptance_status"] = f"reboot_{_LAST_FRESH_BOOT_STATUS}"
        record["reboot_acceptance_status"] = _LAST_FRESH_BOOT_STATUS
        record["kernel_acceptance_status"] = "not_run"
        record["rollback_recommended"] = False
        return record

    record["reboot_acceptance_status"] = "pass"
    if requested_acceptance == "fail" or _LAST_KERNEL_ACCEPTANCE is False:
        record["acceptance_status"] = "fail"
        record["kernel_acceptance_status"] = "fail"
        record["rollback_recommended"] = bool(record["selector_changed"])
    else:
        record["kernel_acceptance_status"] = "pass" if _LAST_KERNEL_ACCEPTANCE is not None else "not_run"
        record["rollback_recommended"] = False
    return record


def fixture_result(path: Path, phase: str) -> dict[str, Any]:
    result = _original_fixture_result(path, phase)
    value = legacy.read_json(path)
    record = result.get("phase_record")
    if isinstance(record, dict):
        acceptance = str(record.get("acceptance_status", ""))
        record["reboot_acceptance_status"] = str(value.get("reboot_acceptance_status", "pass"))
        record["kernel_acceptance_status"] = str(
            value.get("kernel_acceptance_status", "fail" if acceptance == "fail" else "pass")
        )
        record["selector_changed"] = bool(value.get("selector_changed", True))
        record["rollback_recommended"] = bool(
            value.get("rollback_recommended", acceptance == "fail" and record["selector_changed"])
        )
    return result


legacy.target_policy = target_policy
legacy.ensure_cluster_healthy = observe_cluster_health
legacy.run_fresh_boot = run_fresh_boot
legacy.run_phase_acceptance = run_phase_acceptance
legacy.phase_record_value = phase_record_value
legacy.fixture_result = fixture_result

for name in dir(legacy):
    if not name.startswith("_"):
        globals()[name] = getattr(legacy, name)


if __name__ == "__main__":
    raise SystemExit(legacy.main())
