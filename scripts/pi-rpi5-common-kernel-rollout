#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import secrets
import subprocess
import sys
import tempfile
import threading
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Mapping, Sequence

COLLECTOR = "homecluster-rpi5-common-kernel-rollout"
PHASES = ("generic_canary", "egpu_canary", "fleet_rollout", "full_fleet", "rollback_last_phase")
RUNTIME_PHASES = ("generic_canary", "egpu_canary", "fleet_rollout", "full_fleet")
AGENT_GROUP = "k3s_stg_agents"
EGPU_GROUP = "rpi5_egpu_artifact_bundle"
SAFE_RUN_ID = re.compile(r"^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9._-]+$")
FRESH_BOOT_RUN_ID = re.compile(r"^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9]{8}$")
SHA256 = re.compile(r"^[0-9a-f]{64}$")
EXPECTED_ACCEPTED_RUN_ENV = "HOMECLUSTER_RPI5_COMMON_KERNEL_EXPECTED_ACCEPTED_RUN_ID"
EXPECTED_ACCEPTED_SHA_ENV = "HOMECLUSTER_RPI5_COMMON_KERNEL_EXPECTED_ACCEPTED_SHA256"
DEPLOYMENT_ATTEMPT_ENV = "HOMECLUSTER_PXE_DEPLOYMENT_ATTEMPT_ID"
DEPLOYMENT_ATTEMPT_ID = re.compile(r"^deployment-[0-9a-f]{32}$")
KERNEL_RELEASE = re.compile(r"^.+-v8-homecluster\+$")
SELECTOR = re.compile(r"^[0-9]{8}-rpi5$")
TASK_LINE = re.compile(r"^TASK \[(.+?)\](?:\s+\*+)?$")
FAILED_HOST_LINE = re.compile(r"^(?:fatal|failed): \[([^\]]+)\]")
ORIGIN_LINE = re.compile(r"^Origin:\s+(.+)$")
ERROR_LINE = re.compile(r"^\[ERROR\]:\s*(.+)$")
RC_FIELD = re.compile(r'"rc"\s*:\s*(-?\d+)')
MAX_WAIT_SECONDS = 2 * 60 * 60


class RolloutError(RuntimeError):
    def __init__(self, reason: str, status: str = "blocked", diagnostics: Sequence[str] = ()) -> None:
        super().__init__(reason)
        self.reason = reason
        self.status = status
        self.diagnostics = [str(item)[:300] for item in diagnostics][:20]


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def bounded_text(value: object, limit: int = 500) -> str:
    return " ".join(str(value).replace("\x00", "").split())[:limit]


def ansible_failure_diagnostics(
    stdout: str,
    stderr: str = "",
    *,
    stage: str,
    mutation_committed: bool | None,
    power_cycle_started: bool,
    next_check_id: str = "",
) -> list[str]:
    task = ""
    host = ""
    origin = ""
    message = ""
    rc = ""
    for raw in (stdout + "\n" + stderr).splitlines():
        line = raw.strip()
        if not line:
            continue
        task_match = TASK_LINE.match(line)
        if task_match:
            task = bounded_text(task_match.group(1), 240)
            continue
        origin_match = ORIGIN_LINE.match(line)
        if origin_match:
            origin = bounded_text(origin_match.group(1), 300)
            continue
        error_match = ERROR_LINE.match(line)
        if error_match:
            message = bounded_text(error_match.group(1))
            continue
        host_match = FAILED_HOST_LINE.match(line)
        if not host_match:
            continue
        host = bounded_text(host_match.group(1), 120)
        if "=>" in line:
            raw_payload = line.split("=>", 1)[1].strip()
            if raw_payload.startswith("{"):
                try:
                    payload = json.loads(raw_payload)
                except (ValueError, json.JSONDecodeError):
                    payload = {}
                if isinstance(payload, dict):
                    payload_message = payload.get("msg")
                    if isinstance(payload_message, str) and payload_message.strip():
                        message = bounded_text(payload_message)
                    payload_rc = payload.get("rc")
                    if isinstance(payload_rc, int):
                        rc = str(payload_rc)
                    elif isinstance(payload_rc, str) and re.fullmatch(r"-?\d+", payload_rc.strip()):
                        rc = payload_rc.strip()
        if not rc:
            rc_match = RC_FIELD.search(line)
            if rc_match:
                rc = rc_match.group(1)

    diagnostics = [
        f"ansible_failure_stage={bounded_text(stage, 120)}",
        f"ansible_failed_task={task}" if task else "",
        f"ansible_failed_host={host}" if host else "",
        f"ansible_failed_origin={origin}" if origin else "",
        f"ansible_error={message}" if message else "",
        f"ansible_failed_rc={rc}" if rc else "",
        "runtime_mutation_committed="
        + ("unknown" if mutation_committed is None else "true" if mutation_committed else "false"),
        f"power_cycle_started={'true' if power_cycle_started else 'false'}",
        f"ansible_next_check_id={bounded_text(next_check_id, 120)}" if next_check_id else "",
    ]
    return [item for item in diagnostics if item][:20]


def selector_failure_contract(
    returncode: int,
    selector_result: Mapping[str, Any],
) -> tuple[str, str, bool | None, str]:
    """Classify the selector mutation boundary without guessing from process rc alone."""
    selector_status = str(selector_result.get("status", ""))
    if returncode != 0 and selector_status == "applied":
        return (
            "selector_apply_process_failed_after_applied_result",
            "selector_postcheck_process_failure",
            True,
            "common_kernel_current_selector_and_kernel",
        )
    if selector_status == "planned":
        return (
            "selector_apply_failed",
            "selector_mutation_or_postcheck",
            None,
            "common_kernel_current_selector",
        )
    return (
        "selector_apply_failed",
        "pre_mutation_selector_validation",
        False,
        "common_kernel_selector_apply",
    )


def run(
    command: Sequence[str | Path],
    *,
    cwd: Path,
    timeout: int,
    env: Mapping[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            [str(item) for item in command],
            cwd=cwd,
            env=dict(env) if env else None,
            text=True,
            capture_output=True,
            check=False,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise RolloutError("rollout_command_execution_failed", "unknown") from error


def parse_kv(output: str) -> dict[str, str]:
    result: dict[str, str] = {}
    for raw in output.splitlines():
        if "=" not in raw:
            continue
        key, value = raw.split("=", 1)
        if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
            result[key] = value
    return result


def read_json(path: Path) -> dict[str, Any]:
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        raise ValueError("json_object_required")
    return value


def workflow_root() -> Path:
    state_home = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))).expanduser()
    return state_home / "homecluster/rpi5-common-kernel"


class ProgressWriter:
    """Bounded operator hint; the terminal JSON remains the result authority."""

    def __init__(
        self, root: Path, action: str, *, generation_run_id: str = "", deployment_attempt_id: str = ""
    ) -> None:
        if generation_run_id and SAFE_RUN_ID.fullmatch(generation_run_id) is None:
            raise RolloutError("rollout_progress_generation_run_id_invalid")
        if deployment_attempt_id and (
            DEPLOYMENT_ATTEMPT_ID.fullmatch(deployment_attempt_id) is None or not generation_run_id
        ):
            raise RolloutError("rollout_progress_deployment_attempt_id_invalid")
        self.path = root / "progress/current.json"
        self.started = time.monotonic()
        self.lock = threading.RLock()
        self.stop_event = threading.Event()
        self.thread: threading.Thread | None = None
        now = utc_now()
        self.value: dict[str, Any] = {
            "schema": 1,
            "workflow": "rpi5-common-kernel-rollout",
            "attempt_id": f"{datetime.now(timezone.utc):%Y%m%dT%H%M%SZ}-{secrets.token_hex(4)}",
            "generation_run_id": generation_run_id,
            "deployment_attempt_id": deployment_attempt_id,
            "action": action,
            "started_at": now,
            "elapsed_seconds": 0,
            "phase": "accepted",
            "check_id": "rollout_start",
            "check_status": "started",
            "last_transition_at": now,
            "heartbeat_at": now,
            "next_deadline_at": "",
            "mutation_started": False,
            "mutation_committed": False,
            "power_cycle_started": False,
            "terminal": False,
            "status": "in_progress",
        }

    def _emit(self, *, heartbeat: bool) -> None:
        with self.lock:
            now = utc_now()
            self.value["elapsed_seconds"] = int(time.monotonic() - self.started)
            self.value["heartbeat_at"] = now
            if not heartbeat:
                self.value["last_transition_at"] = now
            parent = self.path.parent
            parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            if parent.stat().st_mode & 0o077:
                raise OSError("progress_directory_permissions_invalid")
            fd, temporary = tempfile.mkstemp(prefix=".current-", suffix=".json", dir=parent)
            try:
                with os.fdopen(fd, "w", encoding="utf-8") as handle:
                    os.fchmod(handle.fileno(), 0o600)
                    json.dump(self.value, handle, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
                    handle.write("\n")
                    handle.flush()
                    os.fsync(handle.fileno())
                os.replace(temporary, self.path)
            finally:
                if os.path.exists(temporary):
                    os.unlink(temporary)
            label = "heartbeat" if heartbeat else "transition"
            print(
                f"progress={label} attempt={self.value['attempt_id']} "
                f"elapsed_seconds={self.value['elapsed_seconds']} phase={self.value['phase']} "
                f"check_id={self.value['check_id']} check_status={self.value['check_status']}",
                file=sys.stderr,
                flush=True,
            )

    def start(self) -> None:
        try:
            self._emit(heartbeat=False)
        except OSError as error:
            raise RolloutError("rollout_progress_unavailable") from error
        self.thread = threading.Thread(target=self._heartbeat, daemon=True)
        self.thread.start()

    def _heartbeat(self) -> None:
        while not self.stop_event.wait(45):
            try:
                self._emit(heartbeat=True)
            except OSError:
                print("progress=unavailable", file=sys.stderr, flush=True)
                return

    def transition(self, phase: str, check_id: str, check_status: str, **flags: bool | None) -> None:
        for key in flags:
            if key not in {"mutation_started", "mutation_committed", "power_cycle_started"}:
                raise ValueError("progress_flag_invalid")
        with self.lock:
            self.value.update({"phase": phase, "check_id": check_id, "check_status": check_status, **flags})
            self._emit(heartbeat=False)

    def finish(self, status: str) -> None:
        self.stop_event.set()
        if self.thread is not None:
            self.thread.join(timeout=2)
        with self.lock:
            self.value.update({"phase": "terminal", "check_id": "rollout_result", "check_status": status, "terminal": True, "status": status})
            self._emit(heartbeat=False)


_PROGRESS: ProgressWriter | None = None


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while True:
            chunk = handle.read(1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
    return digest.hexdigest()


def expected_accepted_generation(
    root: Path,
) -> dict[str, str] | None:
    expected_run_id = os.environ.get(EXPECTED_ACCEPTED_RUN_ENV, "").strip()
    expected_sha256 = os.environ.get(EXPECTED_ACCEPTED_SHA_ENV, "").strip()
    if not expected_run_id and not expected_sha256:
        return None
    if (
        SAFE_RUN_ID.fullmatch(expected_run_id) is None
        or SHA256.fullmatch(expected_sha256) is None
    ):
        raise RolloutError("accepted_generation_expectation_invalid", "unknown")

    path = root / "accepted-generation" / f"{expected_run_id}.json"
    try:
        if path.is_symlink() or not path.is_file():
            raise RolloutError(
                "accepted_generation_expected_record_missing",
                "unknown",
            )
        current_sha256 = sha256_file(path)
        value = read_json(path)
    except RolloutError:
        raise
    except (OSError, ValueError, json.JSONDecodeError) as error:
        raise RolloutError(
            "accepted_generation_expected_record_invalid",
            "unknown",
        ) from error

    if (
        current_sha256 != expected_sha256
        or value.get("generation_run_id") != expected_run_id
        or value.get("gate_version") != "rpi5-common-kernel-gate-v2"
    ):
        raise RolloutError("accepted_generation_expectation_changed", "unknown")

    latest = latest_accepted(root)
    if latest.get("generation_run_id") != expected_run_id:
        raise RolloutError("accepted_generation_expectation_superseded", "unknown")
    return {
        "run_id": expected_run_id,
        "sha256": expected_sha256,
        "path": str(path.resolve()),
    }


def latest_accepted(root: Path) -> dict[str, Any]:
    directory = root / "accepted-generation"
    if not directory.is_dir():
        raise RolloutError("accepted_generation_missing")
    for path in sorted(directory.glob("*.json"), reverse=True):
        try:
            value = read_json(path)
        except (OSError, ValueError, json.JSONDecodeError):
            continue
        if (
            SAFE_RUN_ID.fullmatch(str(value.get("generation_run_id", "")))
            and KERNEL_RELEASE.fullmatch(str(value.get("exact_kernel_release", "")))
            and SELECTOR.fullmatch(str(value.get("pxe_candidate_selector", "")))
        ):
            return value
    raise RolloutError("accepted_generation_contract_invalid", "unknown")


def phase_record(root: Path, phase: str) -> dict[str, Any]:
    path = root / "rollout-phases" / f"{phase}.json"
    try:
        return read_json(path)
    except (OSError, ValueError, json.JSONDecodeError):
        return {}


def phase_record_for_generation(
    root: Path, phase: str, generation_run_id: str
) -> dict[str, Any]:
    if SAFE_RUN_ID.fullmatch(generation_run_id) is None:
        raise RolloutError("accepted_generation_run_id_invalid", "unknown")
    record = phase_record(root, phase)
    if record.get("accepted_generation_run_id") != generation_run_id:
        return {}
    return record


def inventory_json(root: Path, inventory: Path) -> dict[str, Any]:
    completed = run(["ansible-inventory", "-i", inventory, "--list"], cwd=root, timeout=180)
    if completed.returncode != 0:
        raise RolloutError("inventory_list_failed")
    try:
        value = json.loads(completed.stdout)
    except (ValueError, json.JSONDecodeError) as error:
        raise RolloutError("inventory_contract_invalid", "unknown") from error
    if not isinstance(value, dict):
        raise RolloutError("inventory_contract_invalid", "unknown")
    return value


def group_hosts(value: Mapping[str, Any], group: str) -> list[str]:
    group_value = value.get(group)
    hosts = group_value.get("hosts") if isinstance(group_value, dict) else None
    if not isinstance(hosts, list) or any(not isinstance(item, str) or not item for item in hosts):
        return []
    return sorted(set(hosts))


def inventory_targets(root: Path, inventory: Path) -> tuple[list[str], str]:
    value = inventory_json(root, inventory)
    agents = group_hosts(value, AGENT_GROUP)
    egpu = group_hosts(value, EGPU_GROUP)
    if len(egpu) != 1:
        raise RolloutError("egpu_target_group_invalid")
    egpu_target = egpu[0]
    if not agents or egpu_target not in agents:
        raise RolloutError("rollout_agent_group_invalid")
    return agents, egpu_target


def target_policy(
    root: Path,
    phase: str,
    agents: Sequence[str],
    egpu_target: str,
    generation_run_id: str,
) -> tuple[list[str], dict[str, Any], str]:
    generic = phase_record_for_generation(root, "generic_canary", generation_run_id)
    egpu = phase_record_for_generation(root, "egpu_canary", generation_run_id)
    fleet = phase_record_for_generation(root, "fleet_rollout", generation_run_id)
    full_fleet = phase_record_for_generation(root, "full_fleet", generation_run_id)
    if phase == "full_fleet":
        if full_fleet.get("acceptance_status") == "pass":
            raise RolloutError("full_fleet_already_accepted")
        if not agents or egpu_target not in agents:
            raise RolloutError("full_fleet_target_contract_invalid")
        return list(agents), {}, phase
    if phase == "generic_canary":
        if generic.get("acceptance_status") == "pass":
            raise RolloutError("generic_canary_already_accepted")
        candidates = sorted(name for name in agents if name != egpu_target)
        if not candidates:
            raise RolloutError("generic_canary_target_unavailable")
        return [candidates[0]], {}, phase
    if phase == "egpu_canary":
        if generic.get("acceptance_status") != "pass":
            raise RolloutError("generic_canary_gate_missing")
        if egpu.get("acceptance_status") == "pass":
            raise RolloutError("egpu_canary_already_accepted")
        return [egpu_target], {}, phase
    if phase == "fleet_rollout":
        if egpu.get("acceptance_status") != "pass":
            raise RolloutError("egpu_canary_gate_missing")
        if fleet.get("acceptance_status") == "pass":
            raise RolloutError("fleet_rollout_already_accepted")
        accepted_targets = set(generic.get("targets", [])) | set(egpu.get("targets", []))
        targets = [name for name in agents if name not in accepted_targets]
        if not targets:
            raise RolloutError("fleet_rollout_targets_empty")
        return targets, {}, phase

    failed: dict[str, Any] = {}
    for candidate in reversed(RUNTIME_PHASES):
        value = phase_record_for_generation(root, candidate, generation_run_id)
        if value.get("acceptance_status") == "fail":
            failed = value
            break
    previous = failed.get("previous_selector_by_node") if failed else None
    targets = failed.get("targets") if failed else None
    failed_phase = str(failed.get("phase", "")) if failed else ""
    if failed_phase not in RUNTIME_PHASES or not isinstance(previous, dict) or not previous:
        raise RolloutError("known_rollback_unavailable")
    if not isinstance(targets, list) or not targets or any(target not in agents for target in targets):
        raise RolloutError("rollback_target_contract_invalid", "unknown")
    for target in targets:
        selector = previous.get(target)
        if not isinstance(selector, dict):
            raise RolloutError("rollback_selector_contract_invalid", "unknown")
        if not SELECTOR.fullmatch(str(selector.get("tftp_release", ""))) or not SELECTOR.fullmatch(
            str(selector.get("rootfs_release", ""))
        ):
            raise RolloutError("rollback_selector_contract_invalid", "unknown")
    return [str(item) for item in targets], previous, failed_phase


def k3s_health_diagnostics(status: Mapping[str, Any]) -> list[str]:
    issues = status.get("issues", [])
    issue_text = ",".join(str(item) for item in issues[:10]) if isinstance(issues, list) else "invalid"
    return [
        f"k3s_status={status.get('status', 'unknown')}",
        f"k3s_reason={status.get('reason', 'unknown')}",
        f"k3s_nodes_ready={status.get('nodes_ready', 'unknown')}",
        f"k3s_nodes_total={status.get('nodes_total', 'unknown')}",
        f"k3s_issues={issue_text or 'none'}",
    ]


def ensure_cluster_healthy(runbook: Path) -> None:
    helper = runbook / "scripts/pi-k3s-status"
    if not helper.is_file():
        raise RolloutError("runbook_k3s_status_helper_missing")
    completed = run(["bash", helper, "--json"], cwd=runbook, timeout=900)
    try:
        status = json.loads(completed.stdout)
    except (ValueError, json.JSONDecodeError) as error:
        raise RolloutError("rollout_k3s_status_contract_invalid", "unknown") from error
    if not isinstance(status, dict):
        raise RolloutError("rollout_k3s_status_contract_invalid", "unknown")

    state = status.get("status")
    diagnostics = k3s_health_diagnostics(status)
    if state == "healthy":
        if completed.returncode != 0:
            raise RolloutError(
                "rollout_k3s_status_exit_mismatch",
                "unknown",
                [*diagnostics, f"k3s_exit_code={completed.returncode}"],
            )
        return
    if state == "converging":
        raise RolloutError("rollout_cluster_converging", "blocked", diagnostics)
    if state == "blocked":
        raise RolloutError("rollout_cluster_blocked", "blocked", diagnostics)
    if state == "unknown":
        raise RolloutError("rollout_cluster_unknown", "unknown", diagnostics)
    raise RolloutError("rollout_k3s_status_contract_invalid", "unknown", diagnostics)


def ensure_no_active_fresh_boot(runbook: Path) -> None:
    script = runbook / ".agents/skills/homecluster-k3s-fresh-boot-acceptance/scripts/status-k3s-fresh-boot-acceptance-job.sh"
    if not script.is_file():
        raise RolloutError("fresh_boot_status_helper_missing")
    completed = run([script], cwd=runbook, timeout=30)
    values = parse_kv(completed.stdout)
    if values.get("status") == "in_progress":
        raise RolloutError("fresh_boot_job_already_active")


def run_fresh_boot(runbook: Path) -> tuple[str, str]:
    scripts = runbook / ".agents/skills/homecluster-k3s-fresh-boot-acceptance/scripts"
    start = scripts / "start-k3s-fresh-boot-acceptance-job.sh"
    wait = scripts / "wait-k3s-fresh-boot-acceptance-job.sh"
    if not start.is_file() or not wait.is_file():
        raise RolloutError("fresh_boot_helper_missing")
    environment = {**os.environ, "HOMECLUSTER_K3S_FRESH_BOOT_POWER_APPLY": "1"}
    started = run([start], cwd=runbook, timeout=60, env=environment)
    start_values = parse_kv(started.stdout)
    if start_values.get("status") not in {"started", "in_progress"}:
        raise RolloutError(start_values.get("reason", "fresh_boot_start_failed"))
    run_id = start_values.get("run_id", "")
    if FRESH_BOOT_RUN_ID.fullmatch(run_id) is None:
        raise RolloutError("fresh_boot_run_id_invalid", "unknown")

    deadline = time.monotonic() + MAX_WAIT_SECONDS
    while time.monotonic() < deadline:
        completed = run(
            [wait],
            cwd=runbook,
            timeout=600,
            env={**environment, "WAIT_TIMEOUT_SECONDS": "540", "POLL_SECONDS": "30"},
        )
        values = parse_kv(completed.stdout)
        status = values.get("status", "unknown")
        if status == "pass":
            return run_id, "pass"
        if status in {"fail", "blocked", "unknown"}:
            return run_id, status
        if status != "in_progress":
            return run_id, "unknown"
    return run_id, "in_progress"


def phase_record_value(
    *,
    phase: str,
    targets: Sequence[str],
    selector_result: Mapping[str, Any],
    accepted: Mapping[str, Any],
    fresh_boot_run_id: str,
    acceptance_status: str,
    started_at: str,
) -> dict[str, Any]:
    return {
        "phase": phase,
        "targets": list(targets),
        "previous_selector_by_node": selector_result.get("previous_selector_by_node", {}),
        "applied_selector_by_node": selector_result.get("applied_selector_by_node", {}),
        "accepted_generation_run_id": str(accepted["generation_run_id"]),
        "exact_kernel_release": str(accepted["exact_kernel_release"]),
        "fresh_boot_run_id": fresh_boot_run_id,
        "acceptance_status": acceptance_status,
        "acceptance_version": "rpi5-common-kernel-phase-v1",
        "started_at": started_at,
        "completed_at": utc_now(),
    }


def fixture_result(path: Path, phase: str) -> dict[str, Any]:
    value = read_json(path)
    status = str(value.get("status", "pass"))
    targets = value.get("targets", ["generic-a"])
    if not isinstance(targets, list):
        raise RolloutError("fixture_contract_invalid", "unknown")
    record_phase = str(value.get("record_phase", "generic_canary" if phase == "rollback_last_phase" else phase))
    acceptance = str(value.get("acceptance_status", "rolled_back" if phase == "rollback_last_phase" else status))
    record = {
        "phase": record_phase,
        "targets": targets,
        "previous_selector_by_node": {str(target): {"tftp_release": "20260730-rpi5", "rootfs_release": "20260730-rpi5"} for target in targets},
        "applied_selector_by_node": {str(target): {"tftp_release": "20260731-rpi5", "rootfs_release": "20260731-rpi5"} for target in targets},
        "accepted_generation_run_id": "20260731T000000Z-stg-generation-1",
        "exact_kernel_release": "6.18.37-v8-homecluster+",
        "fresh_boot_run_id": "20260731T010000Z",
        "acceptance_status": acceptance,
        "acceptance_version": "rpi5-common-kernel-phase-v1",
        "started_at": utc_now(),
        "completed_at": utc_now(),
    }
    return {
        "collector": COLLECTOR,
        "status": status,
        "reason": str(value.get("reason", f"{phase}_accepted")),
        "phase_record": record,
        "diagnostics": [str(item) for item in value.get("diagnostics", []) if isinstance(item, str)],
    }


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description="Fixed Pi5 common-kernel rollout phase")
    result.add_argument("--json", action="store_true")
    result.add_argument("--phase", required=True, choices=PHASES)
    result.add_argument("--fixture", default="", help=argparse.SUPPRESS)
    return result


def main(argv: Sequence[str] | None = None) -> int:
    global _PROGRESS
    args = parser().parse_args(argv)
    progress_started = False
    try:
        if args.fixture:
            result = fixture_result(Path(args.fixture), args.phase)
        else:
            if os.environ.get("HOMECLUSTER_RPI5_COMMON_KERNEL_ROLLOUT_APPLY") != "1":
                raise RolloutError("missing_HOMECLUSTER_RPI5_COMMON_KERNEL_ROLLOUT_APPLY")
            _PROGRESS = ProgressWriter(
                workflow_root(), args.phase,
                generation_run_id=os.environ.get(EXPECTED_ACCEPTED_RUN_ENV, ""),
                deployment_attempt_id=os.environ.get(DEPLOYMENT_ATTEMPT_ENV, ""),
            )
            _PROGRESS.start()
            progress_started = True
            _PROGRESS.transition("selector_inspection", "rollout_preflight", "started")
            root = Path(__file__).resolve().parents[1]
            runbook = Path(os.environ.get("HOMECLUSTER_RUNBOOK_ROOT", str(root.parent / "homecluster-runbook"))).resolve()
            inventory = Path(os.environ.get("HOMECLUSTER_ANSIBLE_INVENTORY", str(root.parent / "inventory.yml"))).resolve()
            if not inventory.is_file() or inventory.stat().st_mode & 0o077:
                raise RolloutError("inventory_entrypoint_invalid")
            branch = run(["git", "-C", root, "branch", "--show-current"], cwd=root, timeout=60)
            dirty = run(["git", "-C", root, "status", "--porcelain"], cwd=root, timeout=60)
            if branch.returncode != 0 or branch.stdout.strip() != "stg":
                raise RolloutError("infra_runtime_branch_not_stg")
            if dirty.returncode != 0 or dirty.stdout.strip():
                raise RolloutError("infra_checkout_dirty")
            workflow_state = workflow_root()
            expected_accepted = (
                None
                if args.phase == "rollback_last_phase"
                else expected_accepted_generation(workflow_state)
            )
            accepted = latest_accepted(workflow_state)
            if (
                expected_accepted is not None
                and accepted.get("generation_run_id")
                != expected_accepted["run_id"]
            ):
                raise RolloutError(
                    "accepted_generation_expectation_superseded",
                    "unknown",
                )
            agents, egpu_target = inventory_targets(root, inventory)
            targets, rollback_selectors, record_phase = target_policy(
                workflow_root(),
                args.phase,
                agents,
                egpu_target,
                str(accepted["generation_run_id"]),
            )
            if args.phase in RUNTIME_PHASES:
                ensure_cluster_healthy(runbook)
            ensure_no_active_fresh_boot(runbook)
            _PROGRESS.transition("selector_inspection", "rollout_preflight", "pass")
            started_at = utc_now()
            playbook = root / "ansible/openwrt/playbooks/rpi5-common-kernel-rollout.yml"
            with tempfile.TemporaryDirectory(prefix="homecluster-common-kernel-rollout-", dir="/tmp") as temporary:
                output = Path(temporary) / "result.json"
                extra = {
                    "homecluster_common_kernel_rollout_phase": args.phase,
                    "homecluster_common_kernel_rollout_output": str(output),
                    "homecluster_common_kernel_rollout_targets": targets,
                    "homecluster_common_kernel_accepted_generation_run_id": accepted["generation_run_id"],
                    "homecluster_common_kernel_exact_release": accepted["exact_kernel_release"],
                    "homecluster_common_kernel_accepted_selector": accepted["pxe_candidate_selector"],
                    "homecluster_common_kernel_accepted_kernel_artifact_id": accepted.get("kernel_artifact_id", ""),
                    "homecluster_common_kernel_accepted_kernel_artifact_manifest_sha256": accepted.get("kernel_artifact_manifest_sha256", ""),
                    "homecluster_common_kernel_accepted_kernel_artifact_payload_sha256": accepted.get("kernel_artifact_payload_sha256", ""),
                    "homecluster_common_kernel_accepted_pxe_release_manifest_sha256": accepted.get("pxe_release_manifest_sha256", ""),
                    "homecluster_common_kernel_expected_accepted_generation_run_id": (
                        expected_accepted["run_id"]
                        if expected_accepted is not None
                        else ""
                    ),
                    "homecluster_common_kernel_expected_accepted_record_sha256": (
                        expected_accepted["sha256"]
                        if expected_accepted is not None
                        else ""
                    ),
                    "homecluster_common_kernel_expected_accepted_record_path": (
                        expected_accepted["path"]
                        if expected_accepted is not None
                        else ""
                    ),
                    "homecluster_common_kernel_rollback_selectors": rollback_selectors,
                }
                _PROGRESS.transition(
                    "selector_apply", "common_kernel_selector_apply", "started",
                    mutation_started=None, mutation_committed=None,
                )
                selector_apply = run(
                    [
                        "ansible-playbook",
                        "-i",
                        inventory,
                        playbook,
                        "--extra-vars",
                        json.dumps(extra, separators=(",", ":")),
                    ],
                    cwd=root / "ansible/openwrt",
                    timeout=1200,
                )
                selector_result: dict[str, Any] = {}
                if output.is_file():
                    try:
                        selector_result = read_json(output)
                    except (ValueError, json.JSONDecodeError):
                        selector_result = {}
                applied = selector_result.get("status") == "applied"
                _PROGRESS.transition(
                    "selector_apply",
                    "common_kernel_selector_apply",
                    "pass" if selector_apply.returncode == 0 and applied else "fail",
                    mutation_started=True if applied else None if selector_result.get("status") == "planned" else False,
                    mutation_committed=True if applied else None if selector_result.get("status") == "planned" else False,
                )
                if selector_apply.returncode != 0 or selector_result.get("status") != "applied":
                    failure_reason, failure_stage, mutation_committed, next_check_id = selector_failure_contract(
                        selector_apply.returncode,
                        selector_result,
                    )
                    record = phase_record_value(
                        phase=record_phase,
                        targets=targets,
                        selector_result=selector_result,
                        accepted=accepted,
                        fresh_boot_run_id="",
                        acceptance_status="fail",
                        started_at=started_at,
                    )
                    result = {
                        "collector": COLLECTOR,
                        "status": "fail",
                        "reason": failure_reason,
                        "phase_record": record,
                        "diagnostics": [
                            "selector_apply=fail",
                            f"selector_result_status={selector_result.get('status', 'missing')}",
                            f"ansible_process_rc={selector_apply.returncode}",
                            f"rollout_targets={','.join(targets)}",
                            *ansible_failure_diagnostics(
                                selector_apply.stdout,
                                selector_apply.stderr,
                                stage=failure_stage,
                                mutation_committed=mutation_committed,
                                power_cycle_started=False,
                                next_check_id=next_check_id,
                            ),
                            "automatic_rollback=false",
                        ],
                    }
                else:
                    fresh_boot_run_id, fresh_boot_status = run_fresh_boot(runbook)
                    if fresh_boot_status != "pass":
                        record = phase_record_value(
                            phase=record_phase,
                            targets=targets,
                            selector_result=selector_result,
                            accepted=accepted,
                            fresh_boot_run_id=fresh_boot_run_id,
                            acceptance_status="fail",
                            started_at=started_at,
                        )
                        result = {
                            "collector": COLLECTOR,
                            "status": "fail" if fresh_boot_status == "fail" else "unknown",
                            "reason": f"fresh_boot_{fresh_boot_status}",
                            "phase_record": record,
                            "diagnostics": ["selector_apply=pass", f"fresh_boot={fresh_boot_status}", "automatic_rollback=false"],
                        }
                    else:
                        accepted_phase, diagnostics = run_phase_acceptance(
                            root,
                            runbook,
                            inventory,
                            args.phase,
                            targets,
                            agents,
                            str(accepted["exact_kernel_release"]),
                        )
                        acceptance_status = (
                            "rolled_back" if args.phase == "rollback_last_phase" and accepted_phase else "pass" if accepted_phase else "fail"
                        )
                        record = phase_record_value(
                            phase=record_phase,
                            targets=targets,
                            selector_result=selector_result,
                            accepted=accepted,
                            fresh_boot_run_id=fresh_boot_run_id,
                            acceptance_status=acceptance_status,
                            started_at=started_at,
                        )
                        result = {
                            "collector": COLLECTOR,
                            "status": "pass" if accepted_phase else "fail",
                            "reason": (
                                "rollback_accepted"
                                if args.phase == "rollback_last_phase" and accepted_phase
                                else f"{args.phase}_accepted"
                                if accepted_phase
                                else f"{args.phase}_acceptance_failed"
                            ),
                            "phase_record": record,
                            "diagnostics": ["selector_apply=pass", "fresh_boot=pass", *diagnostics, "automatic_rollback=false"],
                        }
    except RolloutError as error:
        result = {
            "collector": COLLECTOR,
            "status": error.status,
            "reason": error.reason,
            "diagnostics": error.diagnostics,
        }
    finally:
        if progress_started and _PROGRESS is not None:
            try:
                _PROGRESS.finish(result["status"] if "result" in locals() else "unknown")
            except OSError:
                print("progress=unavailable", file=sys.stderr, flush=True)
            _PROGRESS = None
    if args.json:
        print(json.dumps(result, ensure_ascii=False, sort_keys=True, separators=(",", ":")))
    else:
        print(f"collector={result['collector']}")
        print(f"status={result['status']}")
        print(f"reason={result['reason']}")
    return 0 if result["status"] == "pass" else 2 if result["status"] in {"blocked", "unknown"} else 1

_CURRENT_ACTION = ""
_LAST_FRESH_BOOT_STATUS = ""
_LAST_KERNEL_ACCEPTANCE: bool | None = None
_LAST_SELECTOR_CHANGED: bool | None = None
POSTBOOT_ACCEPTANCE_MAX_ATTEMPTS = 60
POSTBOOT_ACCEPTANCE_TIMEOUT_SECONDS = 60 * 60
_LAST_ROLLOUT_CONTEXT: dict[str, Any] = {}
_PREFLIGHT_ACCEPTANCE: tuple[bool, list[str]] | None = None
_PRE_ROLLOUT_CLUSTER_STATUS = "not_checked"
_PRE_ROLLOUT_CLUSTER_ISSUES = "none"

_original_run = run
_original_target_policy = target_policy
_original_run_fresh_boot = run_fresh_boot
_original_phase_record_value = phase_record_value
_original_fixture_result = fixture_result


def selectors_changed(targets: Sequence[str], selector_result: Mapping[str, Any]) -> bool:
    previous = selector_result.get("previous_selector_by_node")
    applied = selector_result.get("applied_selector_by_node")
    if not isinstance(previous, dict) or not isinstance(applied, dict):
        return False
    return any(previous.get(target) != applied.get(target) for target in targets)


def run(
    command: Sequence[str | Path],
    *,
    cwd: Path,
    timeout: int,
    env: Mapping[str, str] | None = None,
):
    global _LAST_SELECTOR_CHANGED, _LAST_ROLLOUT_CONTEXT
    completed = _original_run(command, cwd=cwd, timeout=timeout, env=env)
    values = [str(item) for item in command]
    rollout_index = next(
        (index for index, value in enumerate(values) if value.endswith("rpi5-common-kernel-rollout.yml")),
        -1,
    )
    if rollout_index < 0:
        return completed
    try:
        extra_index = values.index("--extra-vars")
        extra = json.loads(values[extra_index + 1])
        output = Path(str(extra["homecluster_common_kernel_rollout_output"]))
        selector_result = read_json(output) if output.is_file() else {}
        targets = selector_result.get("targets", extra.get("homecluster_common_kernel_rollout_targets", []))
        if not isinstance(targets, list) or any(not isinstance(item, str) for item in targets):
            raise ValueError("rollout_targets_invalid")
        _LAST_SELECTOR_CHANGED = selectors_changed(targets, selector_result)
        playbook = Path(values[rollout_index]).resolve()
        _LAST_ROLLOUT_CONTEXT = {
            "root": playbook.parents[3],
            "inventory": Path(values[values.index("-i") + 1]).resolve(),
            "targets": list(targets),
            "exact_release": str(extra.get("homecluster_common_kernel_exact_release", "")),
        }
    except (OSError, ValueError, KeyError, IndexError, json.JSONDecodeError):
        _LAST_SELECTOR_CHANGED = None
        _LAST_ROLLOUT_CONTEXT = {}
    return completed


def target_policy(
    root: Path,
    phase: str,
    agents: Sequence[str],
    egpu_target: str,
    generation_run_id: str,
) -> tuple[list[str], dict[str, Any], str]:
    global _CURRENT_ACTION, _LAST_FRESH_BOOT_STATUS, _LAST_KERNEL_ACCEPTANCE
    global _LAST_SELECTOR_CHANGED, _LAST_ROLLOUT_CONTEXT, _PREFLIGHT_ACCEPTANCE
    _CURRENT_ACTION = phase
    _LAST_FRESH_BOOT_STATUS = ""
    _LAST_KERNEL_ACCEPTANCE = None
    _LAST_SELECTOR_CHANGED = None
    _LAST_ROLLOUT_CONTEXT = {}
    _PREFLIGHT_ACCEPTANCE = None

    if phase != "rollback_last_phase":
        return _original_target_policy(root, phase, agents, egpu_target, generation_run_id)

    failed: dict[str, Any] = {}
    for candidate in reversed(RUNTIME_PHASES):
        value = phase_record_for_generation(root, candidate, generation_run_id)
        if value.get("acceptance_status") == "fail" and value.get("rollback_recommended") is True:
            failed = value
            break

    previous = failed.get("previous_selector_by_node") if failed else None
    targets = failed.get("targets") if failed else None
    failed_phase = str(failed.get("phase", "")) if failed else ""
    if failed_phase not in RUNTIME_PHASES or not isinstance(previous, dict) or not previous:
        raise RolloutError("known_rollback_unavailable")
    if not isinstance(targets, list) or not targets or any(target not in agents for target in targets):
        raise RolloutError("rollback_target_contract_invalid", "unknown")
    for target in targets:
        selector = previous.get(target)
        if not isinstance(selector, dict):
            raise RolloutError("rollback_selector_contract_invalid", "unknown")
        if not SELECTOR.fullmatch(str(selector.get("tftp_release", ""))) or not SELECTOR.fullmatch(
            str(selector.get("rootfs_release", ""))
        ):
            raise RolloutError("rollback_selector_contract_invalid", "unknown")
    return [str(item) for item in targets], previous, failed_phase


def run_fresh_boot(runbook: Path) -> tuple[str, str]:
    global _LAST_FRESH_BOOT_STATUS, _PREFLIGHT_ACCEPTANCE
    if _CURRENT_ACTION == "full_fleet" and _LAST_SELECTOR_CHANGED is False and _LAST_ROLLOUT_CONTEXT:
        context = dict(_LAST_ROLLOUT_CONTEXT)
        accepted, diagnostics = run_phase_acceptance(
            Path(context["root"]),
            runbook,
            Path(context["inventory"]),
            "full_fleet",
            list(context["targets"]),
            list(context["targets"]),
            str(context["exact_release"]),
            preflight=True,
        )
        if accepted:
            _PREFLIGHT_ACCEPTANCE = (accepted, diagnostics)
            _LAST_FRESH_BOOT_STATUS = "not_required"
            if _PROGRESS is not None:
                _PROGRESS.transition("fresh_boot", "fresh_boot_reuse", "not_required")
            return "", "pass"
        raise RolloutError("same_selector_acceptance_failed", "blocked", diagnostics)
    if _PROGRESS is not None:
        _PROGRESS.transition("fresh_boot", "fresh_boot_start", "started", power_cycle_started=None)
        _PROGRESS.transition("fresh_boot", "fresh_boot_watch", "waiting")
    run_id, status = _original_run_fresh_boot(runbook)
    _LAST_FRESH_BOOT_STATUS = status
    if _PROGRESS is not None:
        _PROGRESS.transition("fresh_boot", "fresh_boot_watch", status, power_cycle_started=bool(run_id))
    return run_id, status


def _run_phase_acceptance_impl(
    root: Path,
    runbook: Path,
    inventory: Path,
    phase: str,
    targets: Sequence[str],
    all_agents: Sequence[str],
    exact_release: str,
    *,
    preflight: bool = False,
) -> tuple[bool, list[str]]:
    global _LAST_KERNEL_ACCEPTANCE, _PREFLIGHT_ACCEPTANCE
    if not preflight and _PREFLIGHT_ACCEPTANCE is not None:
        cached = _PREFLIGHT_ACCEPTANCE
        _PREFLIGHT_ACCEPTANCE = None
        return cached

    diagnostics: list[str] = []
    playbook = root / "ansible/openwrt/playbooks/rpi5-common-kernel-phase-acceptance.yml"
    expect_exact = phase != "rollback_last_phase"
    acceptance_targets = list(all_agents) if phase in {"fleet_rollout", "full_fleet"} else list(targets)
    completed = run(
        [
            "ansible-playbook",
            "-i",
            inventory,
            playbook,
            "--limit",
            ",".join(acceptance_targets),
            "--extra-vars",
            json.dumps(
                {
                    "homecluster_common_kernel_acceptance_phase": phase,
                    "homecluster_common_kernel_expect_exact_release": expect_exact,
                    "homecluster_common_kernel_exact_release": exact_release,
                },
                separators=(",", ":"),
            ),
        ],
        cwd=root / "ansible/openwrt",
        timeout=900,
    )
    if completed.returncode != 0:
        _LAST_KERNEL_ACCEPTANCE = False
        return False, [
            "phase_runtime_acceptance=fail",
            *ansible_failure_diagnostics(
                completed.stdout,
                completed.stderr,
                stage="phase_acceptance_before_power_cycle" if preflight else "phase_acceptance_after_power_cycle",
                mutation_committed=False if preflight else True,
                power_cycle_started=not preflight,
                next_check_id="common_kernel_phase_acceptance",
            ),
        ]
    diagnostics.append("phase_runtime_acceptance=pass")

    status_helper = runbook / "scripts/pi-k3s-status"
    llm_helper = runbook / "scripts/pi-rpi5-egpu-llm-status"
    if not status_helper.is_file():
        _LAST_KERNEL_ACCEPTANCE = False
        return False, [*diagnostics, "k3s_final_observation=unavailable"]
    if phase in {"egpu_canary", "full_fleet"} and not llm_helper.is_file():
        _LAST_KERNEL_ACCEPTANCE = False
        return False, [*diagnostics, "llm_acceptance_helper=missing"]

    # Fresh boot can report 4/4 Ready before images, workloads, or the GPU service settle.
    # A terminal failure here would incorrectly recommend rollback of a healthy new boot.
    final_status = "unknown"
    final_issues: list[str] = []
    llm_status = "not_checked"
    # Cold boot workloads can take up to an hour to settle after runtime acceptance.
    started_at = time.monotonic()
    accepted_postboot = False
    for attempt in range(1, POSTBOOT_ACCEPTANCE_MAX_ATTEMPTS + 1):
        observed = run(["bash", status_helper, "--json"], cwd=runbook, timeout=90)
        try:
            value = json.loads(observed.stdout)
        except (ValueError, json.JSONDecodeError):
            value = None
        final_status = str(value.get("status", "unknown")) if isinstance(value, dict) else "unknown"
        issues = value.get("issues", []) if isinstance(value, dict) else []
        final_issues = [str(item) for item in issues[:10]] if isinstance(issues, list) else []
        deadline = started_at + POSTBOOT_ACCEPTANCE_TIMEOUT_SECONDS
        if observed.returncode == 0 and final_status == "healthy":
            if phase in {"egpu_canary", "full_fleet"}:
                llm = run(
                    ["bash", llm_helper],
                    cwd=runbook,
                    timeout=90,
                    env={**os.environ, "HOMECLUSTER_RPI5_03_EXPECTED_KERNEL_RELEASE": exact_release},
                )
                values = parse_kv(llm.stdout)
                llm_status = "pass" if (
                    llm.returncode == 0
                    and values.get("llm_status") == "healthy"
                    and values.get("llm_failed_check_ids") == "none"
                    and values.get("llm_unknown_check_ids") == "none"
                ) else "fail"
            else:
                llm_status = "not_required"
            if llm_status in {"pass", "not_required"}:
                diagnostics.extend(["k3s_final_observation=healthy", f"postboot_acceptance_attempts={attempt}"])
                if llm_status == "pass":
                    diagnostics.append("llm_acceptance=pass")
                accepted_postboot = True
                break
        remaining = deadline - time.monotonic()
        if attempt >= POSTBOOT_ACCEPTANCE_MAX_ATTEMPTS or remaining <= 0:
            break
        time.sleep(min(60, remaining))
    if not accepted_postboot:
        diagnostics.extend([f"k3s_final_observation={final_status}", f"postboot_acceptance_attempts={attempt}"])
        if final_issues:
            diagnostics.append("k3s_final_warning_issues=" + ",".join(final_issues))
        diagnostics.append("llm_acceptance=fail" if final_status == "healthy" and llm_status == "fail" else "k3s_final_acceptance=fail")
        _LAST_KERNEL_ACCEPTANCE = False
        return False, diagnostics

    if preflight:
        diagnostics.append("fresh_boot=not_required_current_release_already_accepted")
    _LAST_KERNEL_ACCEPTANCE = True
    return True, diagnostics


def run_phase_acceptance(
    root: Path,
    runbook: Path,
    inventory: Path,
    phase: str,
    targets: Sequence[str],
    all_agents: Sequence[str],
    exact_release: str,
    *,
    preflight: bool = False,
) -> tuple[bool, list[str]]:
    cached_preboot = not preflight and _PREFLIGHT_ACCEPTANCE is not None
    progress_phase = "preboot_acceptance" if preflight or cached_preboot else "postboot_acceptance"
    if _PROGRESS is not None:
        _PROGRESS.transition(progress_phase, "common_kernel_phase_acceptance", "started")
    accepted, diagnostics = _run_phase_acceptance_impl(
        root, runbook, inventory, phase, targets, all_agents, exact_release, preflight=preflight
    )
    if _PROGRESS is not None:
        _PROGRESS.transition(
            progress_phase,
            "common_kernel_phase_acceptance",
            "not_required" if cached_preboot and accepted else "pass" if accepted else "fail",
        )
    return accepted, diagnostics


def artifact_reference(accepted: Mapping[str, Any]) -> dict[str, str]:
    manifest = str(accepted.get("kernel_artifact_manifest_sha256") or accepted.get("generation_manifest_sha256") or "")
    payload = str(accepted.get("kernel_artifact_payload_sha256") or accepted.get("artifact_payload_sha256") or "")
    pxe_release = str(accepted.get("pxe_release_id") or accepted.get("pxe_candidate_selector") or "")
    artifact_id = str(accepted.get("kernel_artifact_id") or (f"sha256:{manifest}" if manifest else ""))
    build_release = str(accepted.get("kernel_artifact_build_release") or accepted.get("pxe_candidate_selector") or "")
    return {
        "kernel_artifact_id": artifact_id,
        "kernel_artifact_build_release": build_release,
        "kernel_artifact_manifest_sha256": manifest,
        "kernel_artifact_payload_sha256": payload,
        "pxe_release_id": pxe_release,
        "pxe_release_manifest_sha256": str(accepted.get("pxe_release_manifest_sha256") or ""),
    }


def phase_record_value(**kwargs: Any) -> dict[str, Any]:
    record = _original_phase_record_value(**kwargs)
    targets = kwargs.get("targets", [])
    selector_result = kwargs.get("selector_result", {})
    fresh_boot_run_id = str(kwargs.get("fresh_boot_run_id", ""))
    requested_acceptance = str(kwargs.get("acceptance_status", ""))
    accepted = kwargs.get("accepted", {})

    record["requested_action"] = _CURRENT_ACTION or str(kwargs.get("phase", ""))
    record.update(artifact_reference(accepted if isinstance(accepted, Mapping) else {}))
    record["pre_rollout_cluster_status"] = _PRE_ROLLOUT_CLUSTER_STATUS
    record["pre_rollout_cluster_issues"] = _PRE_ROLLOUT_CLUSTER_ISSUES
    record["selector_changed"] = selectors_changed(targets, selector_result) if isinstance(targets, Sequence) else False

    if _CURRENT_ACTION == "rollback_last_phase":
        record["reboot_acceptance_status"] = "pass" if _LAST_FRESH_BOOT_STATUS == "pass" else (_LAST_FRESH_BOOT_STATUS or "not_run")
        record["kernel_acceptance_status"] = "not_applicable"
        record["rollback_recommended"] = False
        return record

    if (
        _CURRENT_ACTION == "full_fleet"
        and _LAST_SELECTOR_CHANGED is False
        and not fresh_boot_run_id
        and requested_acceptance == "pass"
        and _LAST_KERNEL_ACCEPTANCE is True
    ):
        record["acceptance_status"] = "pass"
        record["reboot_acceptance_status"] = "not_required"
        record["kernel_acceptance_status"] = "pass"
        record["rollback_recommended"] = False
        return record

    if not fresh_boot_run_id:
        record["acceptance_status"] = "selector_failed" if requested_acceptance == "fail" else requested_acceptance
        record["reboot_acceptance_status"] = "not_run"
        record["kernel_acceptance_status"] = "not_run"
        record["rollback_recommended"] = False
        return record

    if _LAST_FRESH_BOOT_STATUS and _LAST_FRESH_BOOT_STATUS != "pass":
        record["acceptance_status"] = f"reboot_{_LAST_FRESH_BOOT_STATUS}"
        record["reboot_acceptance_status"] = _LAST_FRESH_BOOT_STATUS
        record["kernel_acceptance_status"] = "not_run"
        record["rollback_recommended"] = False
        return record

    record["reboot_acceptance_status"] = "pass"
    if requested_acceptance == "fail" or _LAST_KERNEL_ACCEPTANCE is False:
        record["acceptance_status"] = "fail"
        record["kernel_acceptance_status"] = "fail"
        record["rollback_recommended"] = bool(record["selector_changed"])
    else:
        record["kernel_acceptance_status"] = "pass" if _LAST_KERNEL_ACCEPTANCE is not None else "not_run"
        record["rollback_recommended"] = False
    return record


def fixture_result(path: Path, phase: str) -> dict[str, Any]:
    result = _original_fixture_result(path, phase)
    value = read_json(path)
    record = result.get("phase_record")
    if isinstance(record, dict):
        acceptance = str(record.get("acceptance_status", ""))
        manifest = str(value.get("kernel_artifact_manifest_sha256", "c" * 64))
        record["requested_action"] = phase
        record["kernel_artifact_id"] = str(value.get("kernel_artifact_id", f"sha256:{manifest}"))
        record["kernel_artifact_build_release"] = str(value.get("kernel_artifact_build_release", "20260730-rpi5"))
        record["kernel_artifact_manifest_sha256"] = manifest
        record["kernel_artifact_payload_sha256"] = str(value.get("kernel_artifact_payload_sha256", "d" * 64))
        record["pxe_release_id"] = str(value.get("pxe_release_id", "20260731-rpi5"))
        record["pxe_release_manifest_sha256"] = str(value.get("pxe_release_manifest_sha256", "e" * 64))
        record["reboot_acceptance_status"] = str(value.get("reboot_acceptance_status", "pass"))
        record["kernel_acceptance_status"] = str(value.get("kernel_acceptance_status", "fail" if acceptance == "fail" else "pass"))
        record["selector_changed"] = bool(value.get("selector_changed", True))
        record["rollback_recommended"] = bool(value.get("rollback_recommended", acceptance == "fail" and record["selector_changed"]))
    return result


if __name__ == "__main__":
    raise SystemExit(main())
