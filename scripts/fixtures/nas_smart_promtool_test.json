{
  "rule_files": [
    "rules.json"
  ],
  "evaluation_interval": "1m",
  "tests": [
    {
      "name": "baseline",
      "interval": "1m",
      "input_series": [
        {
          "series": "up{job=\"qnap-nas-file-logs\",instance=\"nas\"}",
          "values": "1+0x480"
        },
        {
          "series": "nas_smart_collection_success{job=\"qnap-nas-file-logs\",instance=\"nas\"}",
          "values": "1+0x480"
        },
        {
          "series": "nas_smart_state_valid{job=\"qnap-nas-file-logs\",instance=\"nas\"}",
          "values": "1+0x480"
        },
        {
          "series": "nas_smart_last_success_timestamp_seconds{job=\"qnap-nas-file-logs\",instance=\"nas\"}",
          "values": "0+60x480"
        },
        {
          "series": "nas_smart_attribute_increments_total{job=\"qnap-nas-file-logs\",instance=\"nas\",bay=\"2\",disk_id=\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",attribute_id=\"188\"}",
          "values": "0+0x480"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "121m",
          "alertname": "NASSMARTAttributeIncreased",
          "exp_alerts": []
        }
      ]
    },
    {
      "name": "new-increment",
      "interval": "1m",
      "input_series": [
        {
          "series": "up{job=\"qnap-nas-file-logs\",instance=\"nas\"}",
          "values": "1+0x480"
        },
        {
          "series": "nas_smart_collection_success{job=\"qnap-nas-file-logs\",instance=\"nas\"}",
          "values": "1+0x480"
        },
        {
          "series": "nas_smart_state_valid{job=\"qnap-nas-file-logs\",instance=\"nas\"}",
          "values": "1+0x480"
        },
        {
          "series": "nas_smart_last_success_timestamp_seconds{job=\"qnap-nas-file-logs\",instance=\"nas\"}",
          "values": "0+60x480"
        },
        {
          "series": "nas_smart_attribute_increments_total{job=\"qnap-nas-file-logs\",instance=\"nas\",bay=\"2\",disk_id=\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",attribute_id=\"188\"}",
          "values": "0+0x119 1+0x360"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "121m",
          "alertname": "NASSMARTAttributeIncreased",
          "exp_alerts": [
            {
              "exp_labels": {
                "job": "qnap-nas-file-logs",
                "instance": "nas",
                "bay": "2",
                "disk_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                "attribute_id": "188",
                "severity": "warning",
                "scope": "nas-smart",
                "source": "prod-outside-in"
              },
              "exp_annotations": {
                "summary": "NAS SMART attribute increased: bay 2, attribute 188"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "failure",
      "interval": "1m",
      "input_series": [
        {
          "series": "up{job=\"qnap-nas-file-logs\",instance=\"nas\"}",
          "values": "1+0x480"
        },
        {
          "series": "nas_smart_collection_success{job=\"qnap-nas-file-logs\",instance=\"nas\"}",
          "values": "0+0x480"
