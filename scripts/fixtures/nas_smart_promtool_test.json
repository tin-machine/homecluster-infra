        {
          "series": "nas_smart_state_valid{job=\"qnap-nas-file-logs\",instance=\"nas\"}",
          "values": "1+0x480"
        },
        {
          "series": "nas_smart_last_success_timestamp_seconds{job=\"qnap-nas-file-logs\",instance=\"nas\"}",
          "values": "0+60x480"
        }
      ],
