alert icmp any any -> $HOME_NET any (msg:"LOCAL validation ICMP echo request"; itype:8; sid:1000001; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"LOCAL repeated inbound SSH SYN candidate"; flags:S; flow:stateless; detection_filter:track by_src, count 12, seconds 60; classtype:attempted-recon; sid:1000002; rev:1;)
